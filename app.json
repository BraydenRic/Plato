{
  "expo": {
    "name": "Plato",
    "slug": "plato",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plato",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.plato.workouts",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.plato.workouts"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.79757088014-02g329vq5alegf7c18lmurd22pnq14l9"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-apple-authentication",
      "./plugins/with-live-activity-rest-timer",
      [
        "expo-live-activity",
        {
          "silentOnUnsupportedOS": true
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Violet",
            "ios": "./assets/icons/icon-violet.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-violet-foreground.png",
              "backgroundColor": "#09090b"
            }
          },
          {
            "name": "Cobalt",
            "ios": "./assets/icons/icon-cobalt.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-cobalt-foreground.png",
              "backgroundColor": "#09090b"
            }
          },
          {
            "name": "Cyan",
            "ios": "./assets/icons/icon-cyan.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-cyan-foreground.png",
              "backgroundColor": "#09090b"
            }
          },
          {
            "name": "Amber",
            "ios": "./assets/icons/icon-amber.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-amber-foreground.png",
              "backgroundColor": "#09090b"
            }
          },
          {
            "name": "Crimson",
            "ios": "./assets/icons/icon-crimson.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-crimson-foreground.png",
              "backgroundColor": "#09090b"
            }
          },
          {
            "name": "Magenta",
            "ios": "./assets/icons/icon-magenta.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-magenta-foreground.png",
              "backgroundColor": "#09090b"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6a5d829-c87d-4b45-9f68-0c9378019e4f"
      }
    },
    "owner": "lm1"
  }
}
