# The map holds user identifiers and emails, and is regenerated by `collect`.
apple-transfer-map.json
# Never let a service account key or an Apple signing key near the repo.
# Firebase saves a new key as <project>-firebase-adminsdk-<id>.json, and it
# could be renamed anything, so no JSON here is tracked but the npm manifests.
*.json
!package.json
!package-lock.json
*.json.key
*.p8
node_modules/
